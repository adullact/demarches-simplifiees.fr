[Unit]
Description="demarche-numerique web server"
After=network.target

[Service]
Type=notify
User=ds
WorkingDirectory=/var/www/ds
ExecStart=/home/ds/.rbenv/shims/bundle exec puma -C config/puma.rb -b tcp://127.0.0.1:8080
ExecRestart=/bin/kill -SIGUSR2 $MAINPID
Environment="RAILS_ENV=production RAILS_LOG_TO_STDOUT=true"
WatchdogSec=10
Restart=always
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ds-web

[Install]
WantedBy=multi-user.target
