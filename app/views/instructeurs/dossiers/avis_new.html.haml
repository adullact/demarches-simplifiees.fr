- content_for(:title, "Avis · Dossier n° #{@dossier.id} (#{@dossier.owner_name})")

= render partial: "header", locals: { dossier: @dossier, gallery_attachments: @gallery_attachments, procedure_presentation: @procedure_presentation, notifications: @notifications, notifications_sticker: @notifications_sticker }

.container
  .fr-grid-row
    .fr-col.fr-col-12.fr-col-md-3
      = render partial: 'instructeurs/avis/sidemenu'
    .fr-col
      - if @dossier.avis_creatable?
        = render partial: "shared/avis/form", locals: { url: avis_instructeur_dossier_path(@dossier.procedure, params[:statut], @dossier), linked_dossiers: @dossier.linked_dossiers_for(current_instructeur).avis_creatable, must_be_confidentiel: false, avis: Avis.new, batch_action: false, procedure: @dossier.procedure }
      - else
        = render partial: "shared/avis/creation_blocked", locals: { dossier: @dossier }
